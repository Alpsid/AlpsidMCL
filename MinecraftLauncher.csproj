<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Minecraft_launcher</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MinecraftLauncher</AssemblyName>
    <ApplicationTitle>Alpsid Mc Launcher</ApplicationTitle>
    <Company>Alpsid</Company>
    <Product>Alpsid Mc Launcher</Product>
    <Description>Alpsid Mc Launcher - Ozel Minecraft Baslatici</Description>
    <Version>1.0.3</Version>
    <FileVersion>1.0.3.0</FileVersion>
    <AssemblyVersion>1.0.3.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CmlLib.Core" Version="4.0.6" />
    <PackageReference Include="CmlLib.Core.Installer.Forge" Version="1.1.1" />
    <PackageReference Include="CmlLib.Core.Installer.NeoForge" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Kurulum/**" />
    <EmbeddedResource Remove="Kurulum/**" />
    <None Remove="Kurulum/**" />
    <Compile Remove="inspect/**" />
    <EmbeddedResource Remove="inspect/**" />
    <None Remove="inspect/**" />
  </ItemGroup>

</Project>
